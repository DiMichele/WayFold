{
  "name": "wayfold-relay",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "WayFold Relay — trasferimento file tra dispositivi vicini via QR animato (fountain codes), senza upload.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-proxy-assets.mjs && vite",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test",
    "build": "node scripts/copy-proxy-assets.mjs && tsc && vite build && node scripts/generate-sw.mjs",
    "build:offline": "npm run build && node scripts/patch-proxy-bundle.mjs && node scripts/generate-sw.mjs",
    "build:offline-zip": "node scripts/build-offline-zip.mjs",
    "build:portable": "node scripts/build-portable.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@mercuryworkshop/wisp-js": "^0.5.3",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "zxing-wasm": "^2.0.0"
  },
  "dependencies": {
    "@mercuryworkshop/bare-mux": "^2.1.9",
    "@mercuryworkshop/epoxy-transport": "^2.1.29",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@titaniumnetwork-dev/ultraviolet": "^3.2.10"
  }
}
