# ──────────────────────────────────────────────
# WayFold — Variabili d'ambiente
# Copia questo file in .env e compila i valori
# ──────────────────────────────────────────────

# Token del bot Telegram (da @BotFather → /newbot)
BOT_TOKEN=

# ID numerico del tuo gruppo Telegram Forum
# Lascia vuoto la prima volta: il bot lo mostrerà nei log
GROUP_ID=

# Opzionale: ID Telegram autorizzati ai comandi admin del bot (virgola-separati).
# Gli amministratori del gruppo sono sempre autorizzati.
# BOT_ADMIN_IDS=

# Porta del server locale (default: 3000)
PORT=3000

# URL base del server (usato nei log e nei messaggi del bot;
# gli URL delle foto sono relativi, quindi non serve cambiarlo per le immagini)
BASE_URL=http://localhost:3000

# ── Sicurezza / multi-utente ──────────────────

# Segreto per firmare i cookie di sessione (obbligatorio).
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Quota upload per utente
UPLOAD_QUOTA_MB=500
UPLOAD_MAX_PHOTOS=1000

# Le foto sono cifrate end-to-end nel browser (AES-256-GCM).
# Il server non possiede chiavi di decifratura: non serve alcuna chiave escrow.

# Foto su disco: in locale (BASE_URL localhost) disattivato automaticamente.
# Forza con PHOTOS_KEEP_LOCAL=true|false
# PHOTOS_KEEP_LOCAL=

# ── Email (recupero password) ─────────────────

# SMTP per l'invio del codice di reset (es. Gmail, SendGrid, Brevo…)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Solo sviluppo: se SMTP non è configurato, stampa il codice in console
MAIL_LOG_CODES=false

# Token Mapbox (mappa globo) — crea su https://account.mapbox.com/access-tokens/
# Consiglia restrizioni URL: wayfold.xyz e localhost
MAPBOX_TOKEN=
